# Jeton du bot fourni par @BotFather (obligatoire)
TELEGRAM_BOT_TOKEN=

# Moteur de génération : pollinations (gratuit, sans clé), openai ou huggingface
IMAGE_PROVIDER=pollinations

# Requis si IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Requis si IMAGE_PROVIDER=huggingface
HF_API_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optionnel : IDs Telegram autorisés, séparés par des virgules (vide = tout le monde)
ALLOWED_USER_IDS=
